# Variables the app actually reads. Set these in Render → Environment.

# Required. Long random string, e.g. output of: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
# Required for /admin
ADMIN_PASSWORD=
# Google Sheet ID (the long ID in the sheet URL)
SHEET_ID=
# SQLite path. On Render this must point at a persistent Disk (e.g. /var/data/clock.db)
# or the database is wiped on every deploy.
DB_PATH=clock.db
# Timezone for punches
TZ=America/New_York

# Google service account JSON goes in a Render Secret File at:
#   /etc/secrets/service_account.json
