{
  "expo": {
    "name": "Crew",
    "slug": "crew",
    "scheme": "crew",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.cwlc.crew",
      "supportsTablet": false
    },
    "android": {
      "package": "com.cwlc.crew"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Crew uses the camera so you can take before and after photos of a job for the office.",
          "photosPermission": "Crew lets you attach job photos from your library for the office.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
